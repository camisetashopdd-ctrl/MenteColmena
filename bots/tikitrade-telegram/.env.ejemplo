# ─── TikiTrade · la liga de entrenadores en Telegram ────────────────────────
# Copia este archivo como .env y rellénalo. El .env NUNCA se comparte ni se sube a GitHub.

# 1. Telegram (obligatorio)
#    Habla con @BotFather en Telegram → /newbot → te da el token.
TELEGRAM_TOKEN=
#    Tu identificador de Telegram como administrador (/admin, /anuncio). Para saberlo, habla con @userinfobot.
TELEGRAM_ADMIN_ID=
#    Opcional: si lo pones, solo podrá fichar quien sepa este código.
CODIGO_INVITACION=
MAX_EQUIPOS=500

# 2. Mercados
#    De dónde salen las velas y los precios (datos públicos, sin claves): binanceusdm · bybit · okx · hyperliquid
EXCHANGE_DATOS=binanceusdm
#    Mercados que puede elegir cada entrenador (futuros perpetuos contra USDT; en Hyperliquid, USDC).
MERCADOS=BTC,ETH,SOL,XRP,BNB,DOGE

# 3. La liga
EQUIPOS_POR_DIVISION=10
JORNADAS_POR_TEMPORADA=4
#    Equipos que suben y bajan entre divisiones al final de cada temporada
ASCIENDEN=2

# 4. Carteras
CAPITAL_DEMO=10000
#    Riesgo por jugada por defecto (cada entrenador lo cambia con /riesgo; en real, como mucho 2 %)
RIESGO_PCT=1
PERDIDA_DIARIA_MAX_PCT=3
DRAWDOWN_MAX_PCT=15

# 5. Tesorería de MenteColmena (activada por defecto; TESORERIA=false para desactivarla)
#    Cada operación aceptada cuesta fichas. Los entrenadores compran fichas con Telegram Stars.
#    1 ficha = ESTRELLAS_POR_FICHA Stars. Una Star vale ≈ 0,013 $ para el club al retirarla (Fragment)
#    y cuesta ≈ 0,02 $ a quien la compra en la app. Con 10 fichas por operación: ≈ 0,13 $ por operación.
#    De cada tarifa, PORCENTAJE_CLUB va al fondo del club y el resto al bote de la división,
#    que se reparte en fichas al final de cada temporada según REPARTO_PREMIOS (% para el 1.º, 2.º, 3.º…).
TESORERIA=true
TARIFA_POR_OPERACION=10
TARIFA_EN_DEMO=true
TARIFA_EN_REAL=true
PORCENTAJE_CLUB=50
REPARTO_PREMIOS=50,30,20
FICHAS_BIENVENIDA=50
PAQUETES_FICHAS=100,250,500
ESTRELLAS_POR_FICHA=1

# 6. Modo real (opcional). Cada entrenador conecta SU exchange o SU wallet con /conectar.
#    Sus claves se guardan cifradas con la CLAVE_MAESTRA. Ponle una frase larga y aleatoria,
#    guárdala bien y no la cambies (si la pierdes o la cambias, las claves guardadas no se pueden leer).
#    Antes de activarlo, lee la sección «Operar con dinero de otros» del LEEME.
PERMITIR_REAL=false
CLAVE_MAESTRA=
